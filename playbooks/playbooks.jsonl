{"question": "How do customer segments compare in spending?", "sql_queries": ["\nSELECT\n    customer_segment,\n    COUNT(DISTINCT user_id) AS num_customers,\n    COUNT(DISTINCT transaction_id) AS num_orders,\n    ROUND(SUM(total), 2) AS total_revenue,\n    ROUND(AVG(total), 2) AS avg_order_value,\n    ROUND(SUM(total) / COUNT(DISTINCT user_id), 2) AS revenue_per_customer,\n    ROUND(COUNT(DISTINCT transaction_id) * 1.0 / COUNT(DISTINCT user_id), 2) AS orders_per_customer,\n    ROUND(SUM(line_margin), 2) AS total_margin,\n    ROUND(SUM(line_margin) / SUM(total) * 100, 2) AS margin_pct\nFROM marts.fct_orders\nWHERE status != 'Cancelled'\nGROUP BY customer_segment\nORDER BY total_revenue DESC\n"], "tables_used": ["marts.fct_orders"], "embedding": [0.014816727, 0.063166045, -0.006141143, 0.023882223, -0.028853625, -0.012087329, -0.008383148, -0.0044109, -0.018033516, 0.060046732, -0.020080565, -0.029243538, 0.000530039, 0.022907438, 0.018228473, -0.052248459, 0.063555956, 0.005239468, 0.002717212, 0.007944494, -0.019203257, -0.068234928, -0.059656817, 0.016571339, 0.014524291, -0.035092246, -0.03431242, 0.039186344, 0.019593172, -0.053418197, -0.038796429, -0.043865312, -0.057317335, -0.002217635, -0.074473545, 0.004581488, -0.053808108, 0.03489729, -0.026514143, -0.030023366, 0.026904054, -0.062776133, -0.011453719, -0.02846371, -8.187e-06, -0.045035053, 0.010040282, -0.102157436, -0.010478935, -0.041915741, -0.009114237, -0.0044109, -0.001547471, 0.00382603, -0.081881911, -0.022420047, -0.021932656, 0.062386218, 0.058487076, -0.015401597, -0.040746, -0.006579797, -0.041135911, 0.034117464, 0.03489729, -0.000740227, 0.010381456, -0.002181081, -0.006531057, 0.018520908, -0.037236772, 0.050298888, -0.042110696, -0.025734315, 0.074863456, 0.057317335, -0.026904054, 0.030608237, -0.036261987, -0.002912169, 0.01140498, 0.002083602, 0.009699107, 0.013549506, 0.002705027, -0.009845325, 0.015596555, -0.015694033, -0.030023366, -0.027683882, 0.025539359, -0.023784745, -0.00994